# Pinned versions of everything the build downloads or builds from outside this repository.
# Sourced by hacks/util.inc (so by every hacks/*.sh script) and by the CI/release workflows.
# Plain `NAME=value` lines only: this file is read by sh, bash and ash.
#
# To update an entry: read the new release's notes and security advisories, change it here, then
# update hacks/checksums.txt (see docs/supply-chain.md). A download whose checksum is not in
# checksums.txt fails the build.
#
# Each can be overridden from the environment to try a newer version, but the build then fails
# on the missing checksum until the new one is added.

# Container image the build scripts run in. Pinned by digest of the multi-arch index.
# Resolve a new one with: docker buildx imagetools inspect alpine:<tag>
: "${ALPINE_IMAGE:=alpine:3.24@sha256:294b683cb724975bec92580e1e685676bd4b50bda910ddb8c51d4cabeaec77e6}"

# Cloud Hypervisor: the sysext bundles the release's static binary; the installer image builds
# the same tag from source (installer/Dockerfile); CI builds it for the integration tests.
# CH_COMMIT is what the tag points to: git ls-remote <repo> 'refs/tags/<tag>^{}'
: "${CH_VERSION:=v54.0}"
: "${CH_COMMIT:=038ce5a72d761380a02f714a4eb4ca63e0ea073d}"

# CNI plugins bundled in the sysext.
: "${CNI_VERSION:=v1.9.1}"

# erofs-utils (mkfs.erofs) is built from the git tag; the commit is checked after the clone.
: "${EROFS_UTILS_VERSION:=1.9.4}"
: "${EROFS_UTILS_COMMIT:=f36cadb5c563995ab3aa8572a60ed6b721b9557d}"

# Guest kernel: an exact version, never "latest" (the tarball is checked against checksums.txt).
: "${KERNEL_VERSION:=6.18.60}"

# crun in the guest rootfs (static, disable-systemd build). Keep CRUN_VERSION and the hashes in guest/rootfs/build-rootfs.sh equal to
# this and to checksums.txt (hacks/build-guest.sh checks the installed binary against checksums.txt).
# 1.30.1 contains the fixes for CVE-2026-30892 (crun exec -u, 1.27), CVE-2026-47766 (rootfs /dev symlink, 1.28), CVE-2026-88264
# (/dev/console symlink, 1.30) and CVE-2026-88265 (/dev/null symlink when reopening the std streams, 1.30).
: "${CRUN_VERSION:=1.30.1}"

# Flatcar sysext-bakery used by hacks/test-sysext.sh (CI test only).
: "${SYSEXT_BAKERY_COMMIT:=445ccc99020d18b07c58c1217b0fcde43fe590c7}"
